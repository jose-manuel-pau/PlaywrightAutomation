{
  "name": "playwrightautomation",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "test": "npx playwright test tests/08-api_testing_with_web_tests/WebAPIPart1.spec.js --headed",
    "test:ui": "playwright test --ui --ui-host=0.0.0.0 --ui-port=9323 --config=playwright.config.js",
    "test:regression": "npx playwright test",
    "test:webTests": "npx playwright test --grep @Web",
    "test:APITests": "npx playwright test --grep @API",
    "test:FirefoxNewConfig": "npx playwright test --config playwright.config1.js --project='Firefox execution'",
    "allure:generate": "allure generate ./allure-results --clean",
    "allure:open": "allure open ./allure-report --host 0.0.0.0 --port 9000"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.0",
    "allure-commandline": "^2.42.1",
    "allure-playwright": "^3.9.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "exceljs": "^4.4.0"
  }
}
